# ── 환경변수 템플릿 ──
# 이 파일을 복사해 사용 환경에 맞춰 실제 값 설정 후,
# IDE Run Configuration 의 Environment Variables, 또는 OS 환경변수로 주입.
# 절대 실제 값을 가진 .env 파일을 커밋하지 말 것.
#
# Spring 프로필별 사용처
#   - (no profile) / prod : application.properties / application-prod.properties → hr.sosyge.net
#   - local / dev         : application-local.properties / application-dev.properties → dev.sosyge.net
# 동일 워크스테이션은 어차피 프로필 한 개만 띄우므로 DB_USERNAME / DB_PASSWORD 단일 쌍이면 충분.

# DB 접속 계정 (csdev 등)
DB_USERNAME=

# DB 비밀번호 (운영/개발 DB 비밀번호가 다르므로 띄우는 프로필에 맞춰 값 교체)
DB_PASSWORD=

# OpenAI (선택) — 미설정 시 빈 값 fallback
OPENAI_API_KEY=
